# Local run. Load with:  set -a; source .env; set +a; cd platform && go run .
# Never committed. Railway holds its own copy of these in the Variables tab.

PORT=8080
SPRUE_DATA=data
SPRUE_URL=http://localhost:8080
SPRUE_ADMIN_EMAIL=you@example.com

# Email. Blank out SPRUE_SMTP_HOST to have local sign-in links print in the log instead.
# Fill it in to test real sending. Password is the 16 letter Gmail app password.
SPRUE_SMTP_HOST=smtp.gmail.com
SPRUE_SMTP_PORT=587
SPRUE_SMTP_USER=
SPRUE_SMTP_PASS=
SPRUE_SMTP_FROM=

# Ko-fi. Page address and the webhook verification token.
SPRUE_KOFI_URL=
SPRUE_KOFI_TOKEN=

# Optional.
SPRUE_DISCORD_URL=
SPRUE_DISCORD_WEBHOOK=
SPRUE_SUPPORT_EMAIL=
SPRUE_ANALYTICS_ID=
SPRUE_VISION_KEY=
